# Database
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=helpdesk
DB_USERNAME=helpdesk_user
DB_PASSWORD=your_strong_password

# MySQL root (must match docker-compose MYSQL_ROOT_PASSWORD)
MYSQL_ROOT_PASSWORD=your_strong_root_password

# Claud-IA
OPENAI_API_KEY=your-openai-api-key
AUTH_SECRET=your-random-secret-at-least-32-chars
SETTINGS_USERNAME=admin
SETTINGS_PASSWORD=your-settings-password

# Integration
CLAUDIA_WEBHOOK_SECRET=your-random-webhook-secret
HELPDESK_DEFAULT_TENANT_ID=1
